# Normaliza los saltos de línea: en el repositorio todo se guarda con LF.
# Cada quien puede trabajar en Windows sin que eso genere diffs falsos.
* text=auto eol=lf

# Código y configuración: siempre LF
*.java   text eol=lf
*.sql    text eol=lf
*.ts     text eol=lf
*.tsx    text eol=lf
*.js     text eol=lf
*.mjs    text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.xml    text eol=lf
*.css    text eol=lf
*.html   text eol=lf
*.sh     text eol=lf

# Scripts de Windows: necesitan CRLF para ejecutarse bien
*.ps1    text eol=crlf
*.bat    text eol=crlf
*.cmd    text eol=crlf

# Binarios: que git no los toque
*.png    binary
*.jpg    binary
*.jpeg   binary
*.ico    binary
*.pdf    binary
*.woff   binary
*.woff2  binary
*.ttf    binary