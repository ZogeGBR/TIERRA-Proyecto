# Copiar a .env y completar. El archivo .env está en .gitignore y no se sube.

# Perfil de Spring. En desarrollo tiene que ser 'dev': es lo que hace que
# Flyway cargue los datos de prueba de db/dev (ver application-dev.yml).
# Sin esta variable el backend arranca igual, pero la base queda vacía.
# El default sin perfil es el comportamiento de produccion, a proposito.
SPRING_PROFILES_ACTIVE=dev

# Base de datos local (tiene que coincidir con tierra-infra/docker-compose.yml)
DB_USUARIO=tierra_app
DB_PASSWORD=tierra_dev_local

# Mercado Pago — access token de PRUEBA (empieza con TEST-).
# Se genera gratis en https://www.mercadopago.com.ar/developers/panel
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000

# Mercado Pago — clave secreta del WEBHOOK (no es el access token de arriba).
# Se genera en el mismo panel: Tus integraciones -> tu aplicacion -> Webhooks ->
# Configurar notificaciones. Sin esto, el endpoint /api/pagos/webhook rechaza
# cualquier notificacion (falla cerrado) en vez de procesarla sin validar la firma.
# No hace falta para levantar el resto del proyecto: solo para probar cobros reales.
MP_WEBHOOK_SECRET=

# Mercado Pago — modo producción. Dejar en false en desarrollo.
# En true la app se niega a arrancar si falta MP_WEBHOOK_SECRET, si el token
# es de prueba o si las URLs de retorno (MP_URL_EXITO, etc.) no son https.
MP_PRODUCCION=false

# Obligatoria en Windows: la JVM reporta "America/Buenos_Aires", que Postgres
# no reconoce (el nombre válido es America/Argentina/Buenos_Aires). Sin esto,
# la conexión falla con 'invalid value for parameter "TimeZone"'.
JAVA_TOOL_OPTIONS=-Duser.timezone=UTC

# --- Autenticacion y CORS ---
# Origenes desde los que se aceptan pedidos del navegador, separados por comas.
# En produccion se agrega el dominio real.
CORS_ORIGENES=http://localhost:3000

# La cookie de sesion viaja solo por HTTPS. En local tiene que ser false
# porque localhost es HTTP; en produccion, true.
SESSION_COOKIE_SECURE=false
