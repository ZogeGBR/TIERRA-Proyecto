{
  "name": "tierra-proyecto",
  "version": "0.1.0",
  "private": true,
  "description": "Proyecto TIERRA - E-commerce y alquiler outdoor",
  "scripts": {
    "dev": "npm --prefix tierra-frontend run dev",
    "build": "npm --prefix tierra-frontend run build",
    "start": "npm --prefix tierra-frontend run start",
    "lint": "npm --prefix tierra-frontend run lint",
    "db:up": "docker compose -f tierra-infra/docker-compose.yml up -d",
    "db:down": "docker compose -f tierra-infra/docker-compose.yml down",
    "db:logs": "docker compose -f tierra-infra/docker-compose.yml logs -f postgres",
    "db:reset": "docker compose -f tierra-infra/docker-compose.yml down -v && docker compose -f tierra-infra/docker-compose.yml up -d"
  }
}
