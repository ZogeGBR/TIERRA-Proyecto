# Copiar a .env.local (que ya está en .gitignore) y completar en cada entorno.
NEXT_PUBLIC_API_URL=http://localhost:8080/api
# Número de WhatsApp de Tierra para consultas de alquiler (solo dígitos, con código de país). Ej: 5492945123456
# Si se deja vacío se usa el WhatsApp real de Tierra (+54 9 2945 699751, ver lib/contacto.ts).
NEXT_PUBLIC_WHATSAPP_ALQUILER=
# Poner 0 para NO usar el catálogo de prueba cuando el backend no responde (obligatorio contra backend real o falso).
NEXT_PUBLIC_CATALOGO_DE_PRUEBA=1
